<?xml version="1.0" encoding="UTF-8"?>
<project name="EduConnect" default="default" basedir=".">
    <description>Builds, tests, and runs the project EduConnect.</description>
    
    <property name="src.dir" location="src"/>
    <property name="build.dir" location="build"/>
    <property name="dist.dir" location="dist"/>
    <property name="test.dir" location="test"/>
    <property name="lib.dir" location="lib"/>
    
    <property name="test.src.dir" location="${test.dir}/main/test"/>
    <property name="test.build.dir" location="${build.dir}/test/classes"/>
    <property name="test.reports.dir" location="${build.dir}/test/results"/>
    
    <path id="classpath.base">
        <pathelement location="${build.dir}/classes"/>
    </path>
    
    <path id="classpath.test">
        <path refid="classpath.base"/>
        <pathelement location="${test.build.dir}"/>
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="init">
        <mkdir dir="${build.dir}/classes"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.dir}/classes" includeantruntime="false">
            <classpath refid="classpath.base"/>
        </javac>
    </target>

    <target name="compile-test" depends="compile">
        <mkdir dir="${test.build.dir}"/>
        <mkdir dir="${test.reports.dir}"/>

        <javac srcdir="${test.src.dir}" destdir="${test.build.dir}" includeantruntime="false">
            <classpath refid="classpath.test"/>
        </javac>
    </target>

    <target name="test" depends="compile-test">
        <echo message="Executando testes unitários..."/>
        <junit printsummary="yes" haltonfailure="no" showoutput="true">
            <classpath refid="classpath.test"/>
            <formatter type="plain"/>
            <formatter type="xml"/>
            
            <batchtest fork="yes" todir="${test.reports.dir}">
                <fileset dir="${test.src.dir}">
                    <include name="**/*Test.java"/>
                </fileset>
            </batchtest>
        </junit>
        
        <echo message="Testes concluídos! Verifique: ${test.reports.dir}"/>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="default" depends="compile"/>
</project>